<Window x:Class="XenAnalyticTransl.Studio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PLC Logic Builder - R&amp;D Studio"
        Height="820" Width="1280" MinHeight="560" MinWidth="880"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8">

    <Window.Resources>
        <SolidColorBrush x:Key="Navy"  Color="#1F3864"/>
        <SolidColorBrush x:Key="Blue"  Color="#1668C1"/>
        <SolidColorBrush x:Key="Line"  Color="#D6DAE2"/>
        <SolidColorBrush x:Key="Panel" Color="White"/>

        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Background" Value="#EDF1F7"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Navy}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="4"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="MinWidth" Value="80"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>            <!-- title bar -->
            <RowDefinition Height="Auto"/>            <!-- model bar -->
            <RowDefinition Height="Auto"/>            <!-- usage bar -->
            <RowDefinition Height="2*" MinHeight="160"/>   <!-- work area -->
            <RowDefinition Height="Auto"/>            <!-- splitter -->
            <RowDefinition Height="1.4*" MinHeight="140"/> <!-- results -->
            <RowDefinition Height="Auto"/>            <!-- status -->
        </Grid.RowDefinitions>

        <!-- ================= title ================= -->
        <Border Grid.Row="0" Background="{StaticResource Navy}" Padding="14,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="PLC Logic Builder" Foreground="White"
                           FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="Natural Language to PLC Logic  -  R&amp;D Studio"
                           Foreground="#AFC6E9" FontSize="12"
                           Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ================= model / provider bar ================= -->
        <Border Grid.Row="1" Background="#E8EEF7" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="110"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Provider" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox  Grid.Column="1" x:Name="ProviderBox" VerticalAlignment="Center"
                           SelectionChanged="ProviderBox_SelectionChanged"/>

                <TextBlock Grid.Column="2" Text="Base URL" VerticalAlignment="Center" Margin="14,0,8,0"/>
                <TextBox   Grid.Column="3" x:Name="BaseUrlBox" VerticalAlignment="Center" Padding="4,3"/>

                <TextBlock Grid.Column="4" Text="Model" VerticalAlignment="Center" Margin="14,0,8,0"/>
                <TextBox   Grid.Column="5" x:Name="ModelBox" VerticalAlignment="Center" Padding="4,3"/>

                <StackPanel Grid.Column="6" Orientation="Horizontal" Margin="14,0,0,0">
                    <Button x:Name="KeyStatusBtn" Content="Key: checking..." Click="CheckKey_Click"
                            ToolTip="Reads the API key from the environment variable. Click to re-check."/>
                    <Button x:Name="TranslateBtn" Content="Request AI Translator"
                            Background="{StaticResource Blue}" Foreground="White" FontWeight="SemiBold"
                            MinWidth="170" Click="Translate_Click"
                            ToolTip="Read the scenario and generate PLC logic using AI"/>
                    <Button x:Name="CancelBtn" Content="Cancel" IsEnabled="False" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= credit / usage ================= -->
        <Border Grid.Row="2" Background="#F7F9FC" BorderBrush="{StaticResource Line}"
                BorderThickness="0,0,0,1" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- paid credit against the key limit -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Paid credit"
                           VerticalAlignment="Center" Margin="0,1,10,1"
                           FontSize="12" Foreground="#333"/>
                <ProgressBar Grid.Row="0" Grid.Column="1" x:Name="UsageBar"
                             Height="7" Minimum="0" Maximum="1" Value="0"
                             VerticalAlignment="Center" Margin="0,3"
                             Background="#D9E4F5" Foreground="{StaticResource Blue}"
                             BorderThickness="0"/>
                <TextBlock Grid.Row="0" Grid.Column="2" x:Name="UsagePct" Text="-"
                           VerticalAlignment="Center" Margin="14,1,0,1"
                           FontSize="12" Foreground="#333" HorizontalAlignment="Right"/>

                <!-- today's free-model requests -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Free models today"
                           VerticalAlignment="Center" Margin="0,1,10,1"
                           FontSize="12" Foreground="#333"/>
                <ProgressBar Grid.Row="1" Grid.Column="1" x:Name="FreeBar"
                             Height="7" Minimum="0" Maximum="1" Value="0"
                             VerticalAlignment="Center" Margin="0,3"
                             Background="#D9E4F5" Foreground="{StaticResource Blue}"
                             BorderThickness="0"/>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="FreePct" Text="-"
                           VerticalAlignment="Center" Margin="14,1,0,1"
                           FontSize="12" Foreground="#333" HorizontalAlignment="Right"/>

                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="3" Content="Refresh"
                        Click="RefreshUsage_Click" MinWidth="70" VerticalAlignment="Center"
                        Margin="14,0,0,0"
                        ToolTip="Re-read spend and remaining allowance from the provider"/>
            </Grid>
        </Border>

        <!-- ================= work area ================= -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="140"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="400" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <!-- general references -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock Text="General References" Style="{StaticResource PanelTitle}"/>
                    </Border>
                    <TreeView x:Name="ReferenceTree" BorderThickness="0" Margin="4"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- statement -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock Text="Statement" Style="{StaticResource PanelTitle}"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
                        <Button Content="Add Scenario" Click="AddScenario_Click"/>
                        <Button Content="Delete Scenario" Click="DeleteScenario_Click"/>
                        <Button Content="Load Sample" Click="LoadSample_Click"/>
                    </StackPanel>
                    <ListBox x:Name="ScenarioList" DockPanel.Dock="Left" Width="150" Margin="6,0,0,6"
                             SelectionChanged="ScenarioList_SelectionChanged"/>
                    <TextBox x:Name="ScenarioText" Margin="6" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" FontSize="13" Padding="8"
                             TextChanged="ScenarioText_TextChanged"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- properties / terms -->
            <Border Grid.Column="4" Style="{StaticResource Card}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock Text="Properties  -  term to PLC variable" Style="{StaticResource PanelTitle}"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6">
                        <Button Content="Add Term" Click="AddTerm_Click"/>
                        <Button Content="Delete Term" Click="DeleteTerm_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="8,2,8,8" TextWrapping="Wrap"
                               Foreground="#666" FontSize="11"
                               Text="Only these variables may appear in generated code. Anything else is flagged as unknown."/>
                    <DataGrid x:Name="TermGrid" AutoGenerateColumns="False" Margin="6,0,6,4"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Term"  Binding="{Binding Name}"     Width="1.3*"/>
                            <DataGridTextColumn Header="PLC Variable" Binding="{Binding Variable}" Width="1.3*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value}"    Width="0.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" Background="#DDE2EA"/>

        <!-- ================= results ================= -->
        <Border Grid.Row="5" Style="{StaticResource Card}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                    <Grid>
                        <TextBlock Text="AI Translation Result (SCL)" Style="{StaticResource PanelTitle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="ResultStatus" Text="Not run yet" VerticalAlignment="Center"
                                       Margin="0,0,14,0" FontSize="12" Foreground="#666"/>
                            <Button Content="Copy SCL" Click="CopyScl_Click"/>
                            <Button Content="Save Run..." Click="SaveRun_Click"
                                    ToolTip="Save scenario, prompt and result as a JSON file for the evaluation set"/>
                            <Button Content="Clear Result" Click="ClearResult_Click"
                                    ToolTip="Empty every result tab. Does not touch the scenario or the terms."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TabControl BorderThickness="0" Margin="4">
                    <TabItem Header="Generated Logic (SCL)">
                        <TextBox x:Name="SclBox" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" Padding="8" Background="#FBFCFE"/>
                    </TabItem>
                    <TabItem Header="Explanation">
                        <TextBox x:Name="ExplanationBox" IsReadOnly="True" TextWrapping="Wrap" FontSize="13"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8"/>
                    </TabItem>
                    <TabItem Header="Validation">
                        <ScrollViewer>
                            <StackPanel Margin="8">
                                <TextBlock Text="Unknown identifiers" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="UnknownBox" TextWrapping="Wrap" Foreground="#B00020"
                                           Text="-" Margin="0,0,0,12"/>
                                <TextBlock Text="Model warnings" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="WarningsBox" TextWrapping="Wrap" Foreground="#8A6100" Text="-"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Context Pack">
                        <TextBox x:Name="ContextBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="8"/>
                    </TabItem>
                    <TabItem Header="Raw Response">
                        <TextBox x:Name="RawBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Padding="8"/>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </Border>

        <!-- ================= status ================= -->
        <Border Grid.Row="6" Background="#EDF1F7" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="10,5">
            <TextBlock x:Name="StatusBar" FontSize="12" Foreground="#444" Text="Ready."
                       TextWrapping="Wrap" MaxHeight="60"/>
        </Border>
    </Grid>
</Window>

